{
  "name": "unforked",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,extension -c green,blue \"npm run dev:api\" \"npm run dev:extension\"",
    "dev:api": "npm run dev --workspace @unforked/api",
    "dev:extension": "npm run dev --workspace @unforked/extension",
    "preview": "vite --config vite.preview.config.ts --host 127.0.0.1",
    "build": "npm run build:extension && npm run build:api",
    "build:extension": "npm run build --workspace @unforked/extension",
    "build:api": "npm run build --workspace @unforked/api",
    "package": "npm run zip --workspace @unforked/extension",
    "typecheck": "npm run setup:types --workspace @unforked/extension && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.109",
    "ai": "7.0.159",
    "hono": "4.13.14",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261031.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "concurrently": "10.0.6",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.156.0",
    "wxt": "0.21.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
